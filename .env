# ── ComTho – Environment Variables ────────────────────────────────────────────
# Copy this file as-is for local development.
# For production, change DB_PASSWORD and JWT_SECRET to strong random values.

# MySQL root password
DB_PASSWORD=ComTho@2024!

# JWT signing secret — change this in production!
JWT_SECRET=comtho-jwt-secret-change-in-production-use-32-chars-minimum

# Port exposed on the host machine (default: 80 → http://localhost)
APP_PORT=80
