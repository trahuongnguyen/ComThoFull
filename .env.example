# ── ComTho – Environment Variables ────────────────────────────────────────────
# Copy file này thành .env và điền giá trị thực trước khi chạy.
# cp .env.example .env

# MySQL root password
DB_PASSWORD=your-strong-password-here

# JWT signing secret — dùng chuỗi ngẫu nhiên ít nhất 32 ký tự
JWT_SECRET=your-random-jwt-secret-at-least-32-chars

# Port expose ra host (mặc định 80 → http://localhost)
APP_PORT=80
