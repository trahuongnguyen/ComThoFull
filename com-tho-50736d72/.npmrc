# NPM Configuration for RestoPOS
# This file ensures npm install installs all dependencies correctly

# Use package-lock.json strictly
package-lock=true

# Install exact versions from package-lock.json
# save-exact=false

# Don't update package-lock.json automatically
# save=false

# Install all optional dependencies
# optional=true

# Install peer dependencies automatically
legacy-peer-deps=true

# Use strict SSL (set to false if having network issues)
strict-ssl=true

# Prefer offline mode if package-lock.json exists
prefer-offline=false

# Don't audit during install (can be slow)
audit=false

# Don't fund during install
fund=false

# Use npm cache
# cache=true

# Maximum retries for network requests
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Timeout for network requests (in milliseconds)
fetch-timeout=300000

# legacy-peer-deps=true